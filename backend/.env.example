# Copy to .env and fill in. Never commit .env.

# Which catalogue this process serves: demo (built-in synthetic data) or live
# (real data imported separately). Each dataset must point at its own database.
# PIVOTT_DATASET=demo

# Local default (no .env needed): sqlite:///./pivott.db
# On a serverless host (Vercel / AWS Lambda) the checkout is read-only, so a
# demo process with no database configured uses an ephemeral file under the
# system temp directory instead; it is reseeded per instance. Set PIVOTT_DB or
# DATABASE_URL to keep saved profiles and user signals.
# Override with PIVOTT_DB if you want a different local file:
# PIVOTT_DB=sqlite:///./demo.db
# A live process MUST set PIVOTT_DB (or DATABASE_URL); it never falls back to
# the demo database:
# PIVOTT_DATASET=live
# PIVOTT_DB=postgresql+psycopg://... (live project)

# Live catalogue (PIVOTT_DATASET=live). The importer downloads O*NET 31.0 and
# one page-range of Arbeitnow postings, then rebuilds the live tables:
#   python -m app.live sync
# PIVOTT_CACHE_DIR=.cache            # where the O*NET zip and job pages are cached
# ADZUNA_APP_ID=                     # optional: better demand counts than title matching
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=de                  # us / gb / de / fr / nl / au ...

# For Supabase, paste the Session pooler string (port 5432), uncomment, and
# use the psycopg driver prefix. URL-encode special characters in the password.
# Leave it commented for local SQLite; a placeholder would override the default.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth (optional). The frontend signs users in with Supabase and sends
# the access token as `Authorization: Bearer ...`; the API verifies it against
# the project's public JWKS. SUPABASE_URL is inferred from DATABASE_URL when it
# is omitted, so the same project that serves the database also serves Auth.
# SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable/anon key is public: GET /api/auth/config returns it so the
# browser can start a sign-in. New projects call it "Publishable key"
# (sb_publishable_...); older projects call it "anon key" (eyJ...). Either name
# below works. Never put the secret/service_role key here.
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# Legacy projects that still sign access tokens with HS256 need the JWT secret
# (server-side only); projects using the default ES256 signing keys do not.
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_TTL_SECONDS=300

# Demo controls. ALLOW_DEMO_RESET=false blocks POST /api/seed; it is always
# blocked for PIVOTT_DATASET=live. PIVOTT_AUTO_SEED=false skips the on-startup
# seed (demo only). CORS_ORIGINS is comma-separated.
ALLOW_DEMO_RESET=true
PIVOTT_AUTO_SEED=true
CORS_ORIGINS=*

# Optional dataset metadata. Demo reads it from the seeded meta table; a live
# importer should write meta.seed_version / meta.data_as_of. These env vars are
# the fallback when the database has no meta row yet.
# PIVOTT_SEED_VERSION=2026.10.1
# PIVOTT_DATA_AS_OF=2026-10-01
