{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs",
      "installCommand": "npx --yes pnpm@12.3.4 install --frozen-lockfile",
      "buildCommand": "npx --yes pnpm@12.3.4 build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
